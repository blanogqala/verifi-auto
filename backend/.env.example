NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://verifi:local-development-only@localhost:5432/verifi_auto
WEB_ORIGIN=http://localhost:5173
# Use same-site frontend/API domains in production; cookies stay HttpOnly, Secure, SameSite=Lax.
COOKIE_SECURE=false
SESSION_HOURS=24
# Explicit number of trusted reverse proxies; 0 for a directly exposed server.
TRUST_PROXY_HOPS=0
# SMTP must be configured to deliver verification and reset links; no fake delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Verifi Auto <noreply@example.com>
# Enabled only in a disposable development/test database. Never a production payment route.
ENABLE_TEST_PAYMENTS=false

# Optional, restricted sandbox-only pilot on a deployed server.
# Comma-separated email addresses of VERIFIED customer test accounts only. Leave empty otherwise.
# Enables simulated TEST payments solely for those accounts; no money is collected or held.
# Remove this setting before onboarding paying customers. Never add genuine customer accounts.
SANDBOX_PAYMENT_TESTER_EMAILS=
